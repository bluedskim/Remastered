# Remastered web (optional login — anonymous usage still works)
# Sign-up: email verification + password only (no display name).
REMASTERED_WEB_SESSION_SECRET=change-me-in-production
REMASTERED_WEB_PUBLIC_BASE_URL=http://localhost:8080

# JWT auth cookie (required in production when using login)
REMASTERED_JWT_SECRET=change-me-in-production
# REMASTERED_JWT_EXPIRY_SECONDS=86400

# Email verification (default: log codes to server logs)
REMASTERED_MAIL_MODE=log
# REMASTERED_MAIL_MODE=resend
# RESEND_API_KEY=re_...
# MAIL_FROM=Remastered <noreply@yourdomain.com>
